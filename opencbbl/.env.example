SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=mikesdemos.ru,www.mikesdemos.ru,localhost,127.0.0.1

# Database Engine (sqlite3 or django.db.backends.postgresql)
DB_ENGINE=django.db.backends.postgresql

# Default DB (auth, sessions, contenttypes)
DB_NAME=opencbbl
DB_USER=opencbbl
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# OpenCBBL DB (organizations, api)
OPENCBBL_DB_NAME=opencbbl_data

# PCManager DB (accounts, inventory, builds, dashboard)
PCMANAGER_DB_NAME=pcmanager_data

# API Keys
YANDEX_GEOCODER_API_KEY=your-yandex-geocoder-api-key
FNS_API_KEY=your-fns-api-key
